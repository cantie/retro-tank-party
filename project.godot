[layer_names]

2d_physics/layer_1="environment"
2d_physics/layer_2="players"
2d_physics/layer_3="bullets"
2d_physics/layer_4="powerups"

[internationalization]

locale/locale_filter_mode=1

[network]

tls/certificate_bundle_override="res://ca-certificates.crt"
rollback/max_buffer_size=15
rollback/interpolation=true
rollback/limits/max_input_frames_per_message=15
rollback/spawn_manager/reuse_despawned_nodes=true
rollback/sound_manager/default_sound_bus="Sound"
rollback/classes/network_adaptor="res://src/utils/RTPNetworkAdaptor.gd"
rollback/classes/message_serializer="res://src/utils/RTPMessageSerializer.gd"
rollback/classes/hash_serializer="res://src/utils/RTPHashSerializer.gd"
rollback/debug/message_bytes=600
rollback/log_inspector/replay_match_scene_path="res://src/main/Match.tscn"

[physics]

common/physics_ticks_per_second=30
2d/default_gravity_vector=Vector2(0, 0)

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
environment/defaults/default_environment="res://default_env.tres"
