; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Retro Tank Party"
config/description="Multiplayer battle tank game"
run/main_scene="res://src/main/Title.tscn"
config/features=PackedStringArray("4.3")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/Loading.png"
config/icon="res://icon.png"

[autoload]

Globals="*res://src/autoload/Globals.tscn"
Build="*res://src/autoload/Build.gd"
SteamManager="*res://src/autoload/SteamManager.gd"
Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
OnlineMatch="*res://addons/nakama-webrtc/OnlineMatch.gd"
GameSettings="*res://src/autoload/GameSettings.gd"
Online="*res://src/autoload/Online.gd"
RemoteOperations="*res://src/autoload/RemoteOperations.gd"
Sounds="*res://src/autoload/Sounds.tscn"
Music="*res://src/autoload/Music.tscn"
Modding="*res://src/autoload/Modding.gd"
Utils="*res://src/autoload/Utils.gd"
SyncManager="*res://addons/godot-rollback-netcode/SyncManager.gd"
SyncDebugger="*res://addons/godot-rollback-netcode/SyncDebugger.gd"
SyncReplay="*res://addons/godot-rollback-netcode/SyncReplay.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
mouse_cursor/custom_image="res://assets/cursor.png"
mouse_cursor/custom_image_hotspot=Vector2(32, 32)
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-rollback-netcode/plugin.cfg")

